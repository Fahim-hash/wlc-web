# Existing Telegram bot secret
TELEGRAM_BOT_TOKEN=

# Strong random secret used by Telegram webhook
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram numeric user IDs allowed to control WLC
TELEGRAM_ADMIN_IDS=

# Optional: used by existing Telegram upload/feed routes
TELEGRAM_CHAT_ID=

# Web Push VAPID keys (keep private key server-only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:wlfsc.sahittoclub@gmail.com

NEXT_PUBLIC_SITE_URL=https://wlc.pro.bd

# Firebase Admin SDK service account JSON (server-only; never expose as NEXT_PUBLIC_*)
FIREBASE_SERVICE_ACCOUNT_JSON=
