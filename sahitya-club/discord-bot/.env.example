# Discord Developer Portal
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Website integration
WLC_API_BASE_URL=https://wlc.pro.bd
DISCORD_BOT_SYNC_SECRET=

# New member welcome system
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_AUTO_ROLE_ID=
# Optional comma-separated role IDs allowed to send messages in the welcome channel
DISCORD_WELCOME_ALLOWED_ROLE_IDS=

# Lavalink audio node (run as a separate persistent Railway service)
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# WLC 24/7 Spotify Radio
MUSIC_GUILD_ID=
MUSIC_VOICE_CHANNEL_ID=
MUSIC_TEXT_CHANNEL_ID=
MUSIC_DEFAULT_VOLUME=35
MUSIC_RADIO_ENABLED=true
# Semicolon-separated Spotify search terms; the bot searches one track when the queue is empty
MUSIC_RADIO_QUERIES=lofi study beats;chill instrumental music;acoustic cafe music;ambient piano music;soft instrumental music

# Required on the Lavalink service for Spotify search/links; create an app at developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
